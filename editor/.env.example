# Copy to .env.local for local dev. On Netlify, set these as site env vars
# in Site configuration → Environment variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-goes-here

# Where the public site lives. Relative image paths in our content
# (`/images/...`) are served by the main mortalsmag deploy, not the
# editor. The editor rewrites those paths to point here so previews
# and thumbnails resolve correctly. Defaults to
# https://mortalsmag.netlify.app when unset.
VITE_PUBLIC_SITE_URL=https://mortalsmag.netlify.app
