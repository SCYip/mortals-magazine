# Copy this file to .env and fill in your Supabase project credentials.
# Find them in your Supabase dashboard → Settings → API.
#
# When BOTH are unset, the site falls back to the static seed bundled in
# src/data/articles.ts. Useful for first-clone, demos, and local dev when
# you haven't set up a Supabase project yet.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-goes-here
